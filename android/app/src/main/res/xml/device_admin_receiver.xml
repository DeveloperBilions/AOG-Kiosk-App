<?xml version="1.0" encoding="utf-8"?>
<!-- Policies this device-admin component is allowed to use. Kept minimal:
     a kiosk needs lock/keyguard control, not password or wipe powers. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
        <disable-keyguard-features />
    </uses-policies>
</device-admin>
